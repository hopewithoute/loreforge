APP_ENV=development
DATABASE_URL=sqlite:///./data/loreforge.sqlite3

MEDIA_ROOT=./data/media
MEDIA_URL=/media

# AI_PROVIDER=cloudflare_flux
# For local testing without API calls, you can use:
# AI_PROVIDER=mock_success
# AI_PROVIDER=mock_timeout
# AI_PROVIDER=mock_broken
AI_PROVIDER=cloudflare_flux
AI_TIMEOUT_SECONDS=60
AI_IMAGE_WIDTH=1024
AI_IMAGE_HEIGHT=1024

CLOUDFLARE_ACCOUNT_ID=replace_me
CLOUDFLARE_API_TOKEN=replace_me
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

MAX_UPLOAD_MB=5
MAX_PROVIDER_REFERENCE_SIZE=511

FRONTEND_DIST=../frontend/dist
